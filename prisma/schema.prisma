generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String
  productos Producto[]
}

model Producto {
  id              Int              @id @default(autoincrement())
  nombre          String
  descripcion     String
  precio          Float
  stock           Int
  categoriaId     Int
  imagenUrl       String?
  extraImages     String?
  specs           String?
  manualUrl       String?
  dimensions      String?
  creadoEn        DateTime         @default(now())
  marca           String?
  imagesByColor   Json?
  descuento       Float?
  precioOriginal  Float?
  promoExpira     DateTime?
  promocion       Boolean          @default(false)
  featuredProduct FeaturedProduct?
  orderItems      OrderItem[]
  categoria       Categoria        @relation(fields: [categoriaId], references: [id])
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  nombre            String
  password          String
  rol               String    @default("user")
  resetToken        String?
  resetTokenExpires DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
}

model Order {
  id                Int          @id @default(autoincrement())
  nombre            String
  apellido          String?
  email             String
  telefono          String
  metodoPago        String
  localRetiro       String
  creadoEn          DateTime     @default(now())
  estado            String       @default("pendiente")
  total             Float        @default(0)
  externalReference String?
  mpPreferenceId    String?
  mpPaymentId       String?
  mpStatus          String?
  comprobante       Comprobante?
  items             OrderItem[]
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  productoId Int
  cantidad   Int
  precio     Float
  order      Order    @relation(fields: [orderId], references: [id])
  producto   Producto @relation(fields: [productoId], references: [id])
}

model HomeSection {
  id         Int    @id @default(autoincrement())
  titulo     String
  subtitulo  String
  textoBoton String
  linkBoton  String
  colorFondo String
  colorTexto String
  imagenUrl  String
}

model PromoCard {
  id          Int    @id @default(autoincrement())
  title       String
  subtitle    String
  description String
  imageUrl    String
  bgColor     String
}

model FeaturedProduct {
  id         Int      @id @default(autoincrement())
  productoId Int      @unique
  producto   Producto @relation(fields: [productoId], references: [id])
}

model Comprobante {
  id            Int      @id @default(autoincrement())
  orderId       Int      @unique
  archivoUrl    String?
  status        String   @default("pendiente_subida")
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  expiraEn      DateTime
  order         Order    @relation(fields: [orderId], references: [id])
}
