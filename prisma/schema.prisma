generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nombre    String
  productos Producto[]
}

model Producto {
  id          Int        @id @default(autoincrement())
  nombre      String
  descripcion String
  precio      Float
  stock       Int
  categoria   Categoria  @relation(fields: [categoriaId], references: [id])
  categoriaId Int
  imagenUrl   String?
  extraImages String?    // Comma-separated URLs de imágenes adicionales
  specs       String?    // Especificaciones del producto (HTML o texto)
  manualUrl   String?    // URL del manual o guía de usuario
  dimensions  String?    // Dimensiones y peso
  creadoEn    DateTime   @default(now())
  marca       String?
  orderItems  OrderItem[]
  featuredProduct FeaturedProduct?
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  nombre   String
  password String
  rol      String @default("user")
}

model Order {
  id            Int          @id @default(autoincrement())
  nombre        String
  apellido      String?
  email         String
  telefono      String
  metodoPago    String
  localRetiro   String
  items         OrderItem[]
  creadoEn      DateTime     @default(now())
  comprobante   Comprobante?
  estado        String       @default("pendiente") // pendiente, retirado
  // Campos de pago (Mercado Pago)
  total         Float        @default(0)
  externalReference String?  // referencia externa (usamos el id de la orden como string)
  mpPreferenceId  String?
  mpPaymentId     String?
  mpStatus        String?    // approved | pending | rejected | refunded | in_process | cancelled | chargeback
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    Int
  producto   Producto @relation(fields: [productoId], references: [id])
  productoId Int
  cantidad   Int
  precio     Float
}

model HomeSection {
  id           Int    @id @default(autoincrement())
  titulo       String
  subtitulo    String
  textoBoton   String
  linkBoton    String
  colorFondo   String
  colorTexto   String
  imagenUrl    String
}

model PromoCard {
  id          Int    @id @default(autoincrement())
  title       String
  subtitle    String
  description String
  imageUrl    String
  bgColor     String
}

model FeaturedProduct {
  id        Int    @id @default(autoincrement())
  producto  Producto @relation(fields: [productoId], references: [id])
  productoId Int @unique
}

model Comprobante {
  id            Int      @id @default(autoincrement())
  order         Order    @relation(fields: [orderId], references: [id])
  orderId       Int      @unique
  archivoUrl    String?
  status        String   @default("pendiente_subida") // pendiente_subida, pendiente_revision, pago_recibido, cancelado
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  expiraEn      DateTime // 48hs después de crear el pedido
}