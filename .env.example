# ==============================================================
# BAMIRA — Variables de entorno (plantilla)
# Copiar a .env.local y completar con valores reales.
# NO versionar el archivo .env / .env.local resultante.
# ==============================================================

# --- Base de datos (Prisma) -----------------------------------
# Requerida. Motor: PostgreSQL.
# El usuario/DB local de desarrollo de BAMIRA usa el contenedor
# Docker `bamira_db` publicado en el puerto host 5437.
DATABASE_URL="postgresql://<usuario>:<password>@localhost:5437/<nombre_db>"

# Opcional: base de datos sombra usada por Prisma Migrate.
SHADOW_DATABASE_URL="postgresql://<usuario>:<password>@localhost:5437/<nombre_db>"

# --- NextAuth --------------------------------------------------
# Requerida. Origen de la app en desarrollo.
NEXTAUTH_URL="http://localhost:3000"

# Requerida. Generar con un valor aleatorio criptografico, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NO usar el valor de ejemplo de abajo en produccion.
NEXTAUTH_SECRET="<generar-secreto-aleatorio>"

# --- MercadoPago ----------------------------------------------
# Requeridas solo si se habilitan pagos con MercadoPago.
# MP_ACCESS_TOKEN es la credencial secreta: nunca exponerla al cliente.
# NEXT_PUBLIC_MP_PUBLIC_KEY si se expone al navegador (debe ser publica).
# Si faltan, /api/mercadopago/config responde enabled=false y el checkout
# ofrece unicamente metodos offline.
MP_ACCESS_TOKEN="<access-token-mercadopago>"
NEXT_PUBLIC_MP_PUBLIC_KEY="<public-key-mercadopago>"

# --- SMTP (Nodemailer) ----------------------------------------
# Requeridas solo para habilitar el envio de correos (recuperacion de contrasena,
# confirmaciones). Sin valores reales, el envio de emails no funcionara.
SMTP_HOST="<host-smtp>"
SMTP_PORT="<puerto-smtp>"
SMTP_USER="<usuario-smtp>"
SMTP_PASS="<password-smtp>"

# --- Sitio / SEO ----------------------------------------------
# Opcionales. Se usan para URLs absolutas en sitemap.xml y metadatos OG.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"

# --- Nota sobre Windows ---------------------------------------
# Si existe una variable DATABASE_URL de nivel usuario o sistema con otro
# formato (por ejemplo postgresql+asyncpg://...), esta tiene prioridad sobre
# el archivo .env y rompe Prisma con P1012. Verificar con:
#   [Environment]::GetEnvironmentVariable('DATABASE_URL','User')
NODE_ENV="development"
